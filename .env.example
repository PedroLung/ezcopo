# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase
# (Project Settings > API). Use só a chave PÚBLICA (publishable ou anon).
# NUNCA coloque aqui a chave secreta (sb_secret_...) ou a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_sua_chave_publica

# Opcional: informações da política de privacidade (LGPD) que aparecem no jogo.
# Contato para dúvidas sobre dados pessoais (e-mail da equipe, por exemplo):
VITE_CONTATO_PRIVACIDADE=equipe.ezcopo@exemplo.com
# Por quanto tempo os dados ficam guardados:
VITE_PRAZO_DADOS=até o fim do semestre letivo de 2026
